# ============================================================
# .env.example — Copia este archivo como .env y rellena los valores
# ============================================================

# --- Base de datos (variables canónicas) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# --- Alias de compatibilidad (opcionales, usan DB_* si ambos están definidos) ---
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_PORT=

# --- Aplicación ---
DEBUG=false

# En producción, reemplazar "*" por el origen real del frontend
CORS_ORIGINS=["*"]

# --- Cupo eléctrico (IDs de reservas separados por comas) ---
ELECTRIC=

# --- Autenticación / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# --- Creación usuario administrador ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_LASTNAME=
ADMIN_EMAIL=

# --- Contraseña por defecto para nuevos usuarios ---
DEFAULT_PASSWORD=
