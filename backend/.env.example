# ============================================================
# .env.example — Copia este archivo como .env y rellena los valores
# ============================================================

# --- Base de datos (variables canónicas) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# --- Alias de compatibilidad (opcionales, usan DB_* si ambos están definidos) ---
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_PORT=

# --- Aplicación ---
DEBUG=false

# Orígenes permitidos para CORS (lista JSON). En producción, usar el origen real del frontend,
# p. ej. CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=["http://localhost:4200"]

# --- Cupo eléctrico (OBSOLETO) ---
# Se configura por apartamento desde la gestión de apartamentos. Esta variable solo la lee
# la migración que activa el cupo de los IDs listados aquí; después puede eliminarse.
ELECTRIC=

# --- Autenticación / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# --- Frontend / Email (restablecimiento de contraseña) ---
# URL pública del frontend; se usa para construir el enlace del email de recuperación.
# En producción debe ser la URL real, p. ej. FRONTEND_URL=https://app.example.com
FRONTEND_URL=http://localhost:4200

# Servidor SMTP de la cuenta EMISORA (una sola, da igual el proveedor del destinatario).
# Si SMTP_HOST se deja vacío, el enlace se imprime por consola (solo desarrollo, no envía).
#
# Gmail (rápido para probar): SMTP_HOST=smtp.gmail.com, requiere 2FA + "contraseña de
#   aplicación" de 16 letras (sin espacios) en SMTP_PASSWORD; NO la contraseña normal.
# Outlook/Office365 personal: NO sirve (Microsoft deshabilitó la auth básica SMTP).
# Producción recomendada: proveedor transaccional (Brevo, Resend, SendGrid, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente mostrado en el email. Si se deja vacío, se usa SMTP_USER.
SMTP_FROM=
SMTP_USE_TLS=true

# --- Creación usuario administrador ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_LASTNAME=
ADMIN_EMAIL=

# --- Contraseña por defecto para nuevos usuarios ---
DEFAULT_PASSWORD=

# --- NAS Synology (documentos de factura vía SSH/SCP / Tailscale) ---
# IP Tailscale del NAS (p. ej. 100.x.x.x). Panel de Tailscale → Machines.
NAS_HOST=
# Puerto SSH del NAS (puerto 2222).
NAS_PORT=2222
NAS_USER=
NAS_PASSWORD=
# Ruta base en el NAS (estilo FileStation, sin /volume1; se antepone NAS_VOLUME_PREFIX).
NAS_BASE_PATH=/facturas
NAS_VOLUME_PREFIX=/volume1
NAS_SSH_TIMEOUT=30

# --- Generación del PDF de factura (Chromium headless) ---
# Ruta al binario de Chromium/Chrome usado para renderizar el recibo a PDF.
# Vacío = autodetección en el PATH. El PDF se sube directamente al NAS (no se guarda en disco).
BILL_PDF_CHROMIUM_PATH=
