# ============================================================
# Plantilla de variables para producción (VPS con Docker Compose)
# Copiar a .env.production en la raíz del repositorio y rellenar.
# NO commitear .env.production (contiene secretos).
# ============================================================

# --- Dominio público (Caddy + Let's Encrypt) ---
# Debe apuntar por DNS a la IP de la VPS antes del primer despliegue.
APP_DOMAIN=app.ejemplo.com

# Etiqueta opcional de imagen (por defecto: latest)
# IMAGE_TAG=latest

# --- Base de datos MySQL EXTERNA (no contenedorizada) ---
DB_HOST=mysql.ejemplo.com
DB_PORT=3306
DB_USER=rentals_app
DB_PASS=
DB_NAME=rentals_prod

# --- Aplicación ---
DEBUG=false
RENTALS_IGNORE_ENV_FILE=1

# Origen CORS: debe coincidir con la URL pública del frontend (HTTPS).
# Formato JSON en una sola línea (sin comillas extra alrededor del valor).
CORS_ORIGINS=["https://app.ejemplo.com"]

# URL pública del frontend (emails de restablecimiento de contraseña).
FRONTEND_URL=https://app.ejemplo.com

# --- Autenticación / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# Contraseña por defecto para nuevos usuarios (obligatoria para arrancar la API).
DEFAULT_PASSWORD=

# --- Email (SMTP) — restablecimiento de contraseña ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- NAS Synology (PDF de facturas vía SSH/SCP; acceso típico vía Tailscale) ---
# Instalar Tailscale en el HOST de la VPS; el contenedor backend alcanza 100.x.x.x.
NAS_HOST=100.x.x.x
NAS_PORT=2222
NAS_USER=
NAS_PASSWORD=
NAS_BASE_PATH=/facturas
NAS_VOLUME_PREFIX=/volume1
NAS_SSH_TIMEOUT=30

# --- PDF de facturas (Chromium en la imagen backend) ---
BILL_PDF_CHROMIUM_PATH=/usr/bin/chromium

# --- Cupo eléctrico (opcional) ---
ELECTRIC=

# --- Bootstrap administrador (solo primera vez, vía docker compose exec) ---
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_LASTNAME=
# ADMIN_EMAIL=
