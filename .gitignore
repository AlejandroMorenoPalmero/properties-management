# ── Secretos y configuración local ──────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example

# Certificados y claves privadas (nunca deben entrar al repositorio)
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# ── Python / FastAPI ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# mypy / ruff
.mypy_cache/
.ruff_cache/

# Caddy
*.bak

# ── Node / Angular ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.angular/cache/
frontend/tmp/
frontend/out-tsc/
frontend/coverage/
frontend/npm-debug.log
frontend/yarn-error.log
frontend/package-lock.json
.pnpm-store/

# ── IDEs ─────────────────────────────────────────────────────────────────────
**/.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.history/

# ── Base de datos local (datos reales del cliente, nunca subir) ──────────────
db/init/
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db

# ── Logs y temporales ────────────────────────────────────────────────────────
*.log
tmp/

# ── Sistema operativo ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
