# ── Secretos y configuración local ──────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example

# ── Python / FastAPI ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# mypy / ruff
.mypy_cache/
.ruff_cache/

# Caddy
*.bak

# ── Node / Angular ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/cache/
frontend/tmp/
frontend/out-tsc/
