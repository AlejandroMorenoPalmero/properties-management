# Dominio público (HTTPS automático con Let's Encrypt salvo localhost).
# Variable inyectada por docker-compose.prod.yml: APP_DOMAIN
{$APP_DOMAIN:localhost} {
	encode gzip zstd

	# API FastAPI (red interna de Compose)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Healthcheck accesible vía proxy (útil para monitorización externa)
	handle /health {
		reverse_proxy backend:8000
	}

	# Assets con hash en el nombre: caché larga
	@hashedAssets path_regexp hashed \.[0-9a-f]{8,}\.(js|css|woff2?)$
	handle @hashedAssets {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA Angular: fallback a index.html para rutas del cliente
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
